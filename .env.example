# ============================================================
# NightWatcher — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# App
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_me_32_chars_random
DEBUG=true
BASE_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./nightwatcher.db

# Email (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_FROM_EMAIL=your@gmail.com
ALERT_TO_EMAILS=admin@example.com

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABCdef...
TELEGRAM_ADMIN_CHAT_IDS=123456789

# Twilio (SMS + Voice)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TO_NUMBERS=+15557654321

# External APIs (all optional for demo)
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
SAFE_BROWSING_API_KEY=
GEMINI_API_KEY=

# Escalation timers (seconds)
ESCALATION_TIER1_SECONDS=180
ESCALATION_TIER2_SECONDS=300

# Login Watcher
LOGIN_LOG_FILE=./demo/sample_logs/auth.log
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60
AUTO_BLOCK_DURATION_MINUTES=60

# Website Watcher (comma-separated URLs you OWN)
WEBSITE_URLS=https://example.com

# Breach Watcher (comma-separated emails with owner consent)
WATCHED_EMAILS=

# Quiet Hours (24h format)
QUIET_HOURS_START=23
QUIET_HOURS_END=7
QUIET_HOURS_ENABLED=false
